rule "Memory secret exfiltration"
metadata:
    category = "exfiltration"
    severity = "high"
strings:
    $send = "(?:send|email|upload|post|forward|exfiltrate)" nocase regex
    $secret = "(?:secrets?|credentials?|api[ _-]?keys?|passwords?|access[ _-]?tokens?|confidential)" nocase regex
    $destination = "(?:https?://|webhook|external endpoint|@[a-z0-9.-]+\.[a-z]{2,})" nocase regex
condition:
    (any e in memory.mutation_requested where
        e.provenance.trust != "trusted" and
        (e.content.text contains $send) and
        (e.content.text contains $secret) and
        (e.content.text contains $destination)) or
    (any e in memory.read_returned where
        e.provenance.trust != "trusted" and
        (e.content.text contains $send) and
        (e.content.text contains $secret) and
        (e.content.text contains $destination))
